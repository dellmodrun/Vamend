{
  "name": "vamend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vamend — vampire protection for memecoins",
  "scripts": {
    "check": "node tools/check.mjs",
    "build:client": "esbuild client/protocol-client.js --bundle --minify --platform=browser --format=iife --global-name=VamendProtocol --outfile=vamend-site/protocol-client.js",
    "build:pages": "npm run build:client && node tools/build-pages.mjs",
    "render:workflow-video": "node tools/render-workflow-video.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "update:ca": "node tools/update-ca.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "^1.56.1"
  },
  "dependencies": {
    "@solana/kit": "^8.6.0",
    "@solana/kit-plugin-rpc": "^0.23.0",
    "@solana/kit-plugin-wallet": "^0.23.0"
  }
}
